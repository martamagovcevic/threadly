# ------------------------------------------------------------------
# Threadly — environment reference
#
# Copy this file to the location it documents (e.g. apps/api/.env)
# and fill in real values. Never commit real secrets.
# ------------------------------------------------------------------

# API server
PORT=4000
NODE_ENV=development

# SQLite database file, relative to apps/api
DATABASE_URL="file:./dev.db"

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Allowed browser origin for the session cookie / CORS
CLIENT_ORIGIN=http://localhost:5173
